# Sólo lo más usado. La lista completa, con defaults, está en DEPLOY.md ("referencia única").

# Ruta absoluta a la DB de misMEM: `~` no se expande
MISMEM_DB=/home/<usuario>/.mismem/mem.db

# Consolidación LLM (opcional, ver engine/src/consolidation/README.md)
# DeepSeek directo gana sobre OpenRouter si están las dos.
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Servidor HTTP: sin estas dos, /mcp y el visor quedan abiertos
# MISMEM_AUTH_USER=brain
# MISMEM_AUTH_PASS=

# Embeddings semánticos (opcional — requiere Ollama local con el modelo bajado)
# MISMEM_EMBEDDINGS=off          # para desactivar la capa semántica
MISMEM_EMBEDDING_URL=http://127.0.0.1:11434
MISMEM_EMBEDDING_MODEL=nomic-embed-text
# O un servidor compatible con OpenAI (ver DEPLOY.md, "Búsqueda por significado"):
# MISMEM_EMBEDDING_PROVIDER=openai
# MISMEM_EMBEDDING_URL=http://127.0.0.1:8080
# MISMEM_EMBEDDING_MODEL=embeddinggemma-2
# MISMEM_EMBEDDING_QUERY_PREFIX="task: search result | query: "
# MISMEM_EMBEDDING_DOC_PREFIX="title: none | text: "
# MISMEM_EMBEDDING_MIN_SCORE=0.65

# Vida media del decay de salience (días, default 90)
MISMEM_SALIENCE_HALF_LIFE_DAYS=90

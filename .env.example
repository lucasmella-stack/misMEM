# Engram remoto opcional (backup cruzado vía MCP HTTP)
ENGRAM_AUTH=Basic XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ENGRAM_URL=https://brain.example.com/mcp

# Path absoluto a la DB de misMEM
MISMEM_DB=C:\Users\<you>\.mismem\mem.db

# Consolidación LLM (opcional, ver engine/src/consolidation/README.md)
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MISMEM_CONSOLIDATION_MODEL=deepseek/deepseek-chat

# Embeddings semánticos (opcional — requiere Ollama local con el modelo bajado)
# MISMEM_EMBEDDINGS=off          # para desactivar la capa semántica
MISMEM_OLLAMA_URL=http://127.0.0.1:11434
MISMEM_EMBEDDING_MODEL=nomic-embed-text

# Vida media del decay de salience (días, default 90)
MISMEM_SALIENCE_HALF_LIFE_DAYS=90

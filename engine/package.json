{
  "name": "@lucasmella/mismem",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.5.0",
  "description": "Cooperative persistent memory for LLMs via MCP — episodes → memories → traits over SQLite (FTS5 + Hebbian recall)",
  "mcpName": "io.github.lucasmella-stack/mismem",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Mella",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmella-stack/misMEM.git",
    "directory": "engine"
  },
  "homepage": "https://github.com/lucasmella-stack/misMEM#readme",
  "bugs": {
    "url": "https://github.com/lucasmella-stack/misMEM/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "llm",
    "agent-memory",
    "sqlite",
    "fts5",
    "claude",
    "persistent-memory"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mismem": "./dist/server.js",
    "mismem-http": "./dist/server-http.js",
    "mismem-ingest": "./dist/ingest-cli.js",
    "mismem-consolidate": "./dist/consolidate-cli.js",
    "mismem-forget": "./dist/forget-cli.js",
    "mismem-migrate-engram": "./dist/migrate-engram-cli.js",
    "mismem-stats": "./dist/stats-cli.js",
    "mismem-embed": "./dist/embed-cli.js",
    "mismem-bench": "./dist/bench-cli.js",
    "mismem-used": "./dist/used-cli.js",
    "mismem-inject": "./dist/inject-cli.js",
    "mismem-obsidian": "./dist/obsidian-cli.js"
  },
  "scripts": {
    "build": "tsc && vite build --config ui/vite.config.ts",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/server-http.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint .",
    "knip": "knip",
    "dup": "jscpd --min-lines 10 --threshold 0.2 --no-gitignore --ignore \"**/*.css\" --reporters console src ui/src",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^12.11.1",
    "ulid": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3-force": "3.0.10",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-force": "3.0.0",
    "jscpd": "4.3.0",
    "knip": "6.41.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "radix-ui": "1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "1.29.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.0"
}

{
  "name": "@mismem/engine",
  "version": "0.1.0",
  "description": "Memoria persistente con consolidacion (episodes -> memories -> traits). MCP stdio.",
  "type": "module",
  "private": true,
  "bin": {
    "mismem": "./dist/server.js",
    "mismem-http": "./dist/server-http.js",
    "mismem-ingest": "./dist/ingest-cli.js",
    "mismem-consolidate": "./dist/consolidate-cli.js",
    "mismem-forget": "./dist/forget-cli.js",
    "mismem-migrate-engram": "./dist/migrate-engram-cli.js",
    "mismem-stats": "./dist/stats-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/server-http.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.5.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}

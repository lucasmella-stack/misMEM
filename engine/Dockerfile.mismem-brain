# misMEM HTTP MCP server — multi-arch (amd64 + arm64)
#
# Uso:
#   docker build -t mismem-brain:latest -f Dockerfile.mismem-brain .
#   docker run -d --name mismem-brain \
#     -e MISMEM_AUTH_USER=brain -e MISMEM_AUTH_PASS=changeme \
#     -v mismem-brain-data:/data \
#     -p 3200:3200 mismem-brain:latest
#
# Variables:
#   MISMEM_HTTP_PORT  (default 3200)
#   MISMEM_HTTP_HOST  (default 0.0.0.0)
#   MISMEM_AUTH_USER  + MISMEM_AUTH_PASS  → activan BasicAuth en /mcp
#   MISMEM_DB         (default /data/mem.db dentro del contenedor)

# ---------- builder ----------
# The digest pins the base image. With the tag alone, a rebuild months later would
# silently pick another Alpine or Node release and recompile the native modules
# against it.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS builder
WORKDIR /app

# better-sqlite3 requiere build tools nativos (gyp + python + g++).
# apk package versions stay unpinned on purpose: Alpine removes old revisions from
# the repositories, so a pinned build would fail later with no change in this repo.
# hadolint ignore=DL3018
RUN apk add --no-cache python3 make g++

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable \
 && pnpm install --frozen-lockfile \
 && pnpm rebuild better-sqlite3

COPY tsconfig.json ./
COPY src ./src
# La interfaz se compila a dist/ui junto con el servidor.
COPY ui ./ui
# The runtime stage copies node_modules as it is, so drop the devDependencies here
# (vite, typescript, react, vitest) instead of shipping them. better-sqlite3 is a
# production dependency and stays. Same layer as the build to keep the layer count down.
RUN pnpm build \
 && pnpm prune --prod

# ---------- runtime ----------
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS runtime
WORKDIR /app

# sqlite CLI por si hace falta inspeccionar la DB; curl para healthcheck.
# Unpinned for the same reason as the builder stage.
# hadolint ignore=DL3018
RUN apk add --no-cache sqlite curl tini \
 && mkdir -p /data \
 && chown -R node:node /data

ENV NODE_ENV=production \
    MISMEM_HTTP_PORT=3200 \
    MISMEM_HTTP_HOST=0.0.0.0 \
    MISMEM_DB=/data/mem.db

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./

USER node
EXPOSE 3200
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:3200/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server-http.js"]
